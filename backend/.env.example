# Database
DB_USER=innovation_user
DB_PASSWORD=innovation_pass
DB_NAME=innovation_hub
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://innovation_user:innovation_pass@db:5432/innovation_hub

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_PORT=8000
ENV=development
LOG_LEVEL=INFO

# Internal Mail Sender (optional; best-effort notification emails)
MAIL_SENDER_ENABLED=false
MAIL_SENDER_URL=https://agent.sec.samsung.net/api/v1/run/mail-sender?stream=false
MAIL_SENDER_API_KEY=
MAIL_SENDER_TIMEOUT_SECONDS=10
APP_PUBLIC_URL=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=avatars
